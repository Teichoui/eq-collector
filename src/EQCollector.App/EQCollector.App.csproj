<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net9.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>EQCollector</AssemblyName>
    <RootNamespace>EQCollector.App</RootNamespace>
    <ApplicationHighDpiMode>SystemAware</ApplicationHighDpiMode>
    <Version>0.3.2</Version>
    <ApplicationIcon>eqcollector.ico</ApplicationIcon>
    <Product>EQ Collector</Product>
    <Company>Norrath Codex</Company>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\EQCollector.Core\EQCollector.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="SharpPcap" Version="6.3.1" />
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="9.0.0" />
  </ItemGroup>

</Project>
